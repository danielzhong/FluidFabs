---
// Adapted from Automark's ProcessCard component.
import Icon from "./Icon.astro";
interface Props {
  number: string;
  icon: string;
  title: string;
  text: string;
  note: string;
  zh: {
    title: string;
    text: string;
    note: string;
  };
}
const { number, icon, title, text, note, zh } = Astro.props;
---

<article class="process-card">
  <div class="step-top">
    <span>{number}</span>
    <Icon name={icon} size={25} />
  </div>
  <h3 data-zh={zh.title}>{title}</h3>
  <p data-zh={zh.text}>{text}</p>
  <span class="step-note" data-zh={zh.note}>
    {note}
  </span>
</article>
