---
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import LanguageToggle from "../components/LanguageToggle.astro";
import { withBase } from "../../lib/paths";
import { navigation, isCurrentPage } from "../../config/navigation";
const links = navigation.map((link) => ({
  ...link,
  href: withBase(link.path),
  current: isCurrentPage(Astro.url.pathname, link.path),
}));
---

<header class="site-header">
  <div class="container header-inner">
    <Logo />
    <nav
      class="desktop-nav"
      aria-label="Main navigation"
      data-zh-aria-label="主导航"
    >
      {links.map((link) => (
        <a
          href={link.href}
          data-zh={link.zh}
          aria-current={link.current ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <button
        class="button button-small button-dark header-cta"
        data-project-trigger
        data-project-interest="Biotech pilot"
      >
        <span data-zh="申请合作试点">Explore a pilot</span>{" "}
        <Icon name="diagonal" size={17} />
      </button>
      <LanguageToggle />
      <ThemeToggle />
      <button
        class="menu-toggle"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
  <nav
    class="mobile-nav"
    id="mobile-nav"
    aria-label="Mobile navigation"
    data-zh-aria-label="移动端导航"
    hidden
  >
    {links.map((link) => (
      <a
        href={link.href}
        data-zh={link.zh}
        aria-current={link.current ? "page" : undefined}
      >
        {link.label}
      </a>
    ))}
    <button
      class="button button-primary"
      data-project-trigger
      data-project-interest="Biotech pilot"
    >
      <span data-zh="申请合作试点">Explore a pilot</span>{" "}
      <Icon name="arrow" size={18} />
    </button>
  </nav>
</header>
<style>
  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  :is(.desktop-nav, .mobile-nav) a[aria-current="page"] {
    color: #1d4ed8;
    font-weight: 650;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 7px;
  }
  .desktop-nav a[aria-current="page"]::after {
    display: none;
  }
  :global(:root[data-theme="dark"])
    :is(.desktop-nav, .mobile-nav)
    a[aria-current="page"] {
    color: #a9d4ff;
  }
  @media (max-width: 600px) {
    .header-actions {
      gap: 8px;
    }
  }
</style>
<script>
  import { localize, LANGUAGE_CHANGE_EVENT } from "../../lib/i18n";
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigation = document.querySelector<HTMLElement>("#mobile-nav");
  const updateLabel = () =>
    toggle?.setAttribute(
      "aria-label",
      toggle.getAttribute("aria-expanded") === "true"
        ? localize("Close navigation", "关闭导航")
        : localize("Open navigation", "打开导航"),
    );
  const close = () => {
    toggle?.setAttribute("aria-expanded", "false");
    updateLabel();
    if (navigation) navigation.hidden = true;
  };
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    updateLabel();
    if (navigation) navigation.hidden = !open;
  });
  navigation?.querySelectorAll("a, button").forEach((link) =>
    link.addEventListener("click", () => {
      if (link.hasAttribute("data-project-trigger")) toggle?.focus();
      close();
    }),
  );
  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      toggle?.getAttribute("aria-expanded") === "true"
    ) {
      toggle.focus();
      close();
    }
  });
  updateLabel();
  window.addEventListener(LANGUAGE_CHANGE_EVENT, updateLabel);
  window.matchMedia("(min-width: 1100px)").addEventListener("change", close);
</script>
