---
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import { site } from "../../config/site";
import { withBase } from "../../lib/paths";
import { navigation, isCurrentPage } from "../../config/navigation";
const links = [...navigation, { label: "FAQs", zh: "常见问题", path: "/faq/" }];
---

<footer class="site-footer">
  <div class="container footer-main">
    <div>
      <Logo />
      <p data-zh={site.taglineZh}>{site.tagline}</p>
    </div>
    <nav
      class="footer-links"
      aria-label="Explore pages"
      data-zh-aria-label="探索页面"
    >
      <span class="footer-label" data-zh="探索">
        EXPLORE
      </span>
      {links.map((link) => (
        <a
          href={withBase(link.path)}
          data-zh={link.zh}
          aria-current={
            isCurrentPage(Astro.url.pathname, link.path) ? "page" : undefined
          }
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="footer-links">
      <span class="footer-label" data-zh="一起探索下一步">
        EXPLORE WHAT’S NEXT
      </span>
      <a href={`mailto:${site.email}`}>
        {site.email} <Icon name="diagonal" size={16} />
      </a>
      <button
        class="text-button"
        data-project-trigger
        data-project-interest="Research partnership"
      >
        <span data-zh="开启合作交流">Start a conversation</span>{" "}
        <Icon name="arrow" size={16} />
      </button>
    </div>
  </div>
  <div class="container footer-bottom">
    <span
      data-zh={`© ${new Date().getFullYear()} ${site.name}。保留所有权利。`}
    >
      © {new Date().getFullYear()} {site.name}. All rights reserved.
    </span>
    <span data-zh="示意模型。研发中的平台。">
      Illustrative models. Platform in development.
    </span>
    <a
      href={withBase("/privacy/")}
      data-zh="隐私说明"
      aria-current={
        isCurrentPage(Astro.url.pathname, "/privacy/") ? "page" : undefined
      }
    >
      Privacy
    </a>
  </div>
</footer>

<style>
  .site-footer a[aria-current="page"] {
    color: #1d4ed8;
    font-weight: 650;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  :global(:root[data-theme="dark"]) .site-footer a[aria-current="page"] {
    color: #a9d4ff;
  }
</style>
