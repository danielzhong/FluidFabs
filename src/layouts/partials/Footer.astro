---
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import { site } from "../../config/site";
import { withBase } from "../../lib/paths";
---

<footer class="site-footer">
  <div class="container footer-main">
    <div>
      <Logo />
      <p data-zh={site.taglineZh}>{site.tagline}</p>
    </div>
    <div class="footer-links">
      <span class="footer-label" data-zh="探索">
        EXPLORE
      </span>
      <a href={withBase("/#platform")} data-zh="平台介绍">
        Platform
      </a>
      <a href={withBase("/#explorer")} data-zh="交互模型">
        Explorer
      </a>
      <a href={withBase("/#roadmap")} data-zh="开发路线">
        Roadmap
      </a>
      <a href={withBase("/#partners")} data-zh="合作交流">
        Partners
      </a>
      <a href={withBase("/#faq")} data-zh="常见问题">
        FAQs
      </a>
    </div>
    <div class="footer-links">
      <span class="footer-label" data-zh="一起探索下一步">
        EXPLORE WHAT’S NEXT
      </span>
      <a href={`mailto:${site.email}`}>
        {site.email} <Icon name="diagonal" size={16} />
      </a>
      <button
        class="text-button"
        data-project-trigger
        data-project-interest="Research partnership"
      >
        <span data-zh="开启合作交流">Start a conversation</span>{" "}
        <Icon name="arrow" size={16} />
      </button>
    </div>
  </div>
  <div class="container footer-bottom">
    <span
      data-zh={`© ${new Date().getFullYear()} ${site.name}。保留所有权利。`}
    >
      © {new Date().getFullYear()} {site.name}. All rights reserved.
    </span>
    <span data-zh="示意模型。研发中的平台。">
      Illustrative models. Platform in development.
    </span>
    <a href={withBase("/privacy/")} data-zh="隐私说明">
      Privacy
    </a>
  </div>
</footer>
