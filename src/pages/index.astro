---
import Base from "../layouts/Base.astro";
import Badge from "../layouts/components/Badge.astro";
import Icon from "../layouts/components/Icon.astro";
import FlowField from "../layouts/components/FlowField.astro";
import { withBase } from "../lib/paths";
import "../styles/platform.css";
import "../styles/pages.css";

const pages = [
  {
    path: "/explorer/",
    slug: "explorer",
    icon: "sliders",
    title: "Explore the model",
    titleZh: "探索交互模型",
    text: "Start with published particle measurements. Change the conditions and explore illustrative concentration profiles and diffusion times.",
    textZh:
      "从文献中的颗粒实测值出发，调整条件，探索浓度分布与扩散时间的示意计算。",
    label: "Open the explorer",
    labelZh: "打开交互模型",
    featured: true,
  },
  {
    path: "/platform/",
    slug: "platform",
    icon: "layers",
    title: "Meet the platform",
    titleZh: "了解平台理念",
    text: "See how particle properties, environments, and time connect in our modeling concept.",
    textZh: "了解我们的建模概念如何将颗粒属性、环境条件与时间联系起来。",
    label: "Discover the platform",
    labelZh: "了解平台",
    featured: false,
  },
  {
    path: "/experiments/",
    slug: "experiments",
    icon: "scan",
    title: "From model to experiment",
    titleZh: "从模型走向实验",
    text: "Explore planned studies connecting particle characterization, concentration observations, and model outputs.",
    textZh: "探索规划中的实验研究，连接颗粒表征、浓度观察与模型输出。",
    label: "Explore the experiments",
    labelZh: "查看实验规划",
    featured: false,
  },
  {
    path: "/roadmap/",
    slug: "roadmap",
    icon: "mix",
    title: "See what comes next",
    titleZh: "了解下一步方向",
    text: "Follow the path from this concept to planned experimental validation and future research.",
    textZh: "了解从当前概念到实验验证，以及未来研究方向的开发路线。",
    label: "View the roadmap",
    labelZh: "查看开发路线",
    featured: false,
  },
  {
    path: "/partners/",
    slug: "partners",
    icon: "cells",
    title: "Build with us",
    titleZh: "一起推进研究",
    text: "Discuss a biotech pilot, request an investor walkthrough, or express interest in product updates.",
    textZh: "讨论 biotech 合作试点、预约投资人演示，或表达对产品进展的关注。",
    label: "Find your starting point",
    labelZh: "了解合作方式",
    featured: false,
  },
];
// Keep previously shared section links useful after the move to separate pages.
const legacyRoutes = Object.fromEntries([
  ...pages.map(({ slug, path }) => [`#${slug}`, withBase(path)]),
  ["#faq", withBase("/faq/")],
  ["#workflow", withBase("/platform/#workflow")],
  ["#literature", withBase("/explorer/#literature")],
]);
---

<Base>
  <section class="hero platform-hero">
    <div class="hero-halo" aria-hidden="true"></div>
    <FlowField />
    <div class="container hero-content">
      <Badge title="A new lens on particle transport" zh="重新理解颗粒传输" />
      <h1 data-zh="看见颗粒的变化。<br /><span>找到下一步方向。</span>">
        See how particles move.
        <br />
        <span>Explore what comes next.</span>
      </h1>
      <p class="hero-tagline" data-zh="让颗粒行为清晰可见。">
        Particle behavior, made visible.
      </p>
      <p
        class="hero-description"
        data-zh="我们正在构建一个药物颗粒建模平台：按 ζ 电位范围组织颗粒，探索不同溶液与通道条件下的浓度分布和扩散时间。"
      >
        We’re developing a modeling platform to group drug particles by zeta
        potential and explore concentration profiles and diffusion times across
        solution and channel conditions.
      </p>
      <div class="hero-actions">
        <button
          class="button button-primary"
          data-project-trigger
          data-project-interest="Biotech pilot"
        >
          <span data-zh="申请合作试点">Explore a pilot</span>
          <Icon name="arrow" size={19} />
        </button>
        <a class="button button-outline" href={withBase("/explorer/")}>
          <span data-zh="体验概念演示">Explore the concept</span>
          <Icon name="sliders" size={18} />
        </a>
      </div>
      <div class="hero-footnote">
        <span></span>
        <span data-zh="概念阶段 · 文献实测值 · 开放研究合作">
          Concept stage · Published measurements · Open to research partners
        </span>
      </div>
    </div>
  </section>

  <div class="research-strip container">
    <span data-zh="从颗粒属性<br /><strong>到可检验的研究问题</strong>">
      FROM PARTICLE PROPERTIES
      <br />
      <strong>TO TESTABLE QUESTIONS</strong>
    </span>
    <div>
      <Icon name="sliders" size={21} />
      <span data-zh="ζ 电位分组">Zeta-potential cohorts</span>
    </div>
    <div>
      <Icon name="drop" size={21} />
      <span data-zh="溶液条件">Solution conditions</span>
    </div>
    <div>
      <Icon name="mix" size={21} />
      <span data-zh="浓度分布">Concentration profiles</span>
    </div>
    <div>
      <Icon name="scan" size={21} />
      <span data-zh="扩散时间尺度">Diffusion timescales</span>
    </div>
  </div>

  <section class="section home-pages" aria-labelledby="discover-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow" data-zh="探索 FLUID FABS">
            EXPLORE FLUID FABS
          </span>
          <h2 id="discover-heading" data-zh="从这里开始。">
            Choose where to begin.
          </h2>
        </div>
        <p data-zh="从交互演示到未来的实验，每一个方向都有独立空间，方便你深入了解。">
          From an interactive concept to future experiments, find the part of
          Fluid Fabs you want to explore.
        </p>
      </div>
      <div class="page-grid">
        {pages.map((page, index) => (
          <a
            href={withBase(page.path)}
            class:list={["page-card", { "page-card-featured": page.featured }]}
            aria-labelledby={`page-card-${page.slug}-title`}
          >
            <div class="page-card-top" aria-hidden="true">
              <Icon name={page.icon} size={27} />
              <span>0{index + 1}</span>
            </div>
            <h3 id={`page-card-${page.slug}-title`} data-zh={page.titleZh}>
              {page.title}
            </h3>
            <p data-zh={page.textZh}>{page.text}</p>
            <div class="page-card-action">
              <span data-zh={page.labelZh}>{page.label}</span>
              <Icon name="arrow" size={19} />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <script is:inline define:vars={{ legacyRoutes }}>
    const openLegacyPage = () => {
      const destination = legacyRoutes[window.location.hash];
      if (destination) window.location.replace(destination);
    };
    openLegacyPage();
    window.addEventListener("hashchange", openLegacyPage);
  </script>
</Base>
